# MongoDB Atlas database-user credentials. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DB=closer_intellect
MONGODB_COLLECTION=inquiries

# Resend server-side sending credentials and routing.
RESEND_API_KEY=re_replace_with_a_sending_only_key
RESEND_FROM="Closer Intellect <hello@mail.closerintellect.ai>"
SALES_NOTIFICATION_EMAIL=sales@closerintellect.ai

# Exact registration or onboarding destination shown after both emails are accepted.
ONBOARDING_URL=https://app.closerintellect.ai
